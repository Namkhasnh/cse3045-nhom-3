                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Notification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "body",
          "href",
          "restaurant_id",
          "source_id",
          "source_version",
          "created_at",
          "read_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "pattern": "^/"
          },
          "restaurant_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          },
          "read_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "current_context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "restaurant_id",
              "status",
              "description",
              "href"
            ],
            "properties": {
              "restaurant_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            }
          }
        }
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unread_count"
        ],
        "properties": {
          "unread_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Step": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "complete",
          "status",
          "href",
          "description",
          "assignee"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "complete": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "Hoàn tất",
              "Cần bạn làm",
              "Chờ Admin",
              "Chờ chủ quán"
            ]
          },
          "href": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assignee": {
            "enum": [
              "owner",
              "admin"
            ]
          }
        }
      },
      "Guide": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "restaurant_id",
          "name",
          "version",
          "public_visible",
          "orderable",
          "is_open",
          "steps"
        ],
        "properties": {
          "restaurant_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "public_visible": {
            "type": "boolean"
          },
          "orderable": {
            "type": "boolean"
          },
          "is_open": {
            "type": "boolean"
          },
          "steps": {
            "type": "array",
            "minItems": 7,
            "maxItems": 7,
            "items": {
              "$ref": "#/components/schemas/Step"
            }
          }
        }
      },
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "href"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        }
      }
    }
  }
}
