    "/notifications/read-all": {
      "post": {
        "responses": {
          "200": {
            "description": "Successful scoped operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false,
                  "properties": {
