          "403": {
            "description": "Current authority or CSRF denied"
          },
          "404": {
            "description": "Resource outside scope"
          },
          "422": {
            "description": "Closed input validation failed"
          }
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "applications",
                "delivery",
                "restaurants"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          }
        ]
      }
    },
    "/notifications/setup/{restaurant_id}": {
