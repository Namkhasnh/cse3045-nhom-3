  "paths": {
    "/notifications": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful scoped operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "page"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Notification"
                      }
                    },
                    "page": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "has_more",
                        "next_cursor"
                      ],
                      "properties": {
                        "has_more": {
                          "type": "boolean"
                        },
                        "next_cursor": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[1-9][0-9]{0,18}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Session invalid"
          },
          "403": {
            "description": "Current authority or CSRF denied"
          },
          "404": {
            "description": "Resource outside scope"
          },
          "422": {
            "description": "Closed input validation failed"
          }
        },
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          {
            "name": "unread",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "true",
                "false"
              ]
            }
          }
        ]
      }
    },
