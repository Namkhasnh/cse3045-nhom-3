  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test:compile": "tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test '.test-dist/src/**/*.spec.js'",
    "test:e2e": "npm run test:compile && node --test '.test-dist/test/**/*.e2e-spec.js'",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prebuild": "npm run prisma:generate",
    "predev": "npm run prisma:generate",
    "prestart": "npm run prisma:generate",
    "pretest:compile": "npm run prisma:generate",
    "db:check": "npm run build && node dist/prisma/db-check.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
