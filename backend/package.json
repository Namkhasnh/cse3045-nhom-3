{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch --path tsconfig.dev.json",
    "start:prod": "node dist/main.js",
    "test:compile": "node scripts/clean-test-output.mjs && tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test '.test-dist/src/**/*.spec.js'",
    "test:e2e": "npm run test:compile && node --test '.test-dist/test/**/*.e2e-spec.js'",
    "test:integration": "npm run test:compile && node test/integration/run.mjs",
    "test:cli": "npm run build && node test/cli/run.mjs",
    "test:smtp": "npm run test:compile && node test/cli/smtp.mjs",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prebuild": "npm run prisma:generate",
    "predev": "node scripts/check-dev-port.mjs && npm run prisma:generate",
    "test:dev-runtime": "node --test test/dev-runtime.test.mjs",
    "prestart": "npm run prisma:generate",
    "pretest:compile": "npm run prisma:generate",
    "db:check": "npm run build && node dist/prisma/db-check.js",
    "account:provision": "npm run build && node dist/provision/account-provision.js",
    "db:bootstrap": "node scripts/bootstrap-empty.mjs",
    "db:inventory": "node scripts/retained-inventory.mjs",
    "db:rehearse": "node scripts/rehearse-retained.mjs",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "test:permissions": "node test/permissions.mjs",
    "test:compatibility": "npm run build && node test/compatibility.mjs",
    "test:onboarding-upgrade": "node scripts/verify-onboarding-upgrade.mjs",
    "onboarding:cleanup:local": "npm run build && node dist/maintenance-onboarding-local.js",
    "test:onboarding-permissions": "npm run test:compile && node test/onboarding-restricted.mjs",
    "test:prepare": "node scripts/prepare-test-db.mjs && npm run db:migrate",
    "media:cleanup:local": "npm run build && node dist/maintenance-media-local.js",
    "demo:local": "npm run build && node scripts/local-demo.mjs",
    "orders:configure:local": "npm run build && node scripts/configure-local-orders.mjs --confirm-hlf-dev-flow",
    "payments:cleanup:local": "npm run build && node dist/maintenance-payments-local.js",
    "privacy:cleanup:local": "npm run build && node dist/maintenance-privacy-local.js",
    "test:administration-permissions": "npm run test:compile && node test/administration-permissions.mjs",
    "test:ai-evaluation": "npm run build && node scripts/evaluate-ai.mjs",
    "test:ai-permissions": "npm run test:compile && node test/recommendations-permissions.mjs",
    "ai:cleanup": "npm run build && node dist/maintenance-ai.js",
    "test:ai-evaluation-unit": "node --test test/ai-evaluation-summary.test.mjs",
    "test:storefront-upgrade": "node scripts/verify-storefront-upgrade.mjs",
    "test:storefront-permissions": "npm run test:compile && node test/storefront-restricted.mjs",
    "test:owner-analytics": "npm run test:compile && node --test .test-dist/test/integration/owner-analytics.integration-spec.js",
    "test:order-code-upgrade": "node scripts/verify-order-code-upgrade.mjs",
    "test:voucher-upgrade": "node scripts/verify-voucher-upgrade.mjs",
    "test:cod-upgrade": "node scripts/verify-cod-upgrade.mjs",
    "test:avatar-upgrade": "node scripts/verify-restaurant-avatar-upgrade.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "express": "5.2.1",
    "mariadb": "3.4.5",
    "nodemailer": "7.0.11",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/nodemailer": "7.0.4",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
