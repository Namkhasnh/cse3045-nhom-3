{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test:compile": "node scripts/clean-test-output.mjs && tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test '.test-dist/src/**/*.spec.js'",
    "test:e2e": "npm run test:compile && node --test '.test-dist/test/**/*.e2e-spec.js'",
    "test:integration": "npm run test:compile && node test/integration/run.mjs",
    "test:cli": "npm run build && node test/cli/run.mjs",
    "test:smtp": "npm run test:compile && node test/cli/smtp.mjs",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prebuild": "npm run prisma:generate",
    "predev": "npm run prisma:generate",
    "prestart": "npm run prisma:generate",
    "pretest:compile": "npm run prisma:generate",
    "db:check": "npm run build && node dist/prisma/db-check.js",
    "account:provision": "npm run build && node dist/provision/account-provision.js",
    "db:bootstrap": "node scripts/bootstrap-empty.mjs",
    "db:inventory": "node scripts/retained-inventory.mjs",
    "db:rehearse": "node scripts/rehearse-retained.mjs",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "test:permissions": "node test/permissions.mjs",
    "test:compatibility": "npm run build && node test/compatibility.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.7",
    "mariadb": "3.4.5",
    "nodemailer": "7.0.11",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "7.0.4",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
