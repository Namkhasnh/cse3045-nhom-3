generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
  moduleFormat        = "esm"
}

datasource db {
  provider = "mysql"
}

model Account {
  id                    BigInt                  @id @default(autoincrement())
  loginIdentifier       String                  @unique @map("login_identifier")
  passwordHash          String                  @map("password_hash") @db.VarChar(255)
  role                  AccountRole
  displayName           String                  @map("display_name") @db.VarChar(200)
  phone                 String?                 @db.VarChar(32)
  isActive              Boolean                 @default(true) @map("is_active")
  authVersion           Int                     @default(1) @map("auth_version") @db.UnsignedInt
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at")
  version               Int                     @default(1) @db.UnsignedInt
  email                 String?                 @unique @db.VarChar(254)
  emailVerifiedAt       DateTime?               @map("email_verified_at")
  emailCodeHash         String?                 @map("email_code_hash") @db.Char(64)
  emailCodeExpiresAt    DateTime?               @map("email_code_expires_at")
  emailCodeSentAt       DateTime?               @map("email_code_sent_at")
  emailCodeAttempts     Int                     @default(0) @map("email_code_attempts") @db.UnsignedInt
  roleRequest           AccountRoleRequest?     @relation("Applicant")
  reviewedRequests      AccountRoleRequest[]    @relation("Reviewer")
  auditLogs             AuditLog[]
  commission_entries    commission_entries[]
  order_payment_history order_payment_history[]
  order_payments        order_payments[]
  order_requests        order_requests[]
  order_status_history  order_status_history[]
  orders                orders[]
  restaurants           restaurants[]
  adminOperatorRequests AdminOperatorRequest[]
  adminAuthority        AdminAuthority?
  adminFactor           AdminFactor?
  adminChallenges       AdminChallenge[]
  adminRecoveryCodes    AdminRecoveryCode[]

  @@map("accounts")
}

model AccountRoleRequest {
  id            BigInt            @id @default(autoincrement())
  accountId     BigInt            @unique @map("account_id")
  requestedRole AccountRole       @map("requested_role")
  status        RoleRequestStatus @default(pending)
  requestedAt   DateTime          @default(now()) @map("requested_at")
  reviewedAt    DateTime?         @map("reviewed_at")
  reviewedBy    BigInt?           @map("reviewed_by")
  applicant     Account           @relation("Applicant", fields: [accountId], references: [id])
  reviewer      Account?          @relation("Reviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([status, requestedAt, id])
  @@index([reviewedBy], map: "account_role_requests_reviewed_by_fkey")
  @@map("account_role_requests")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt   @map("actor_id")
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(64)
  targetId   BigInt   @map("target_id")
  changes    Json
  requestId  String?  @map("request_id") @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at")
  actor      Account  @relation(fields: [actorId], references: [id], onUpdate: Restrict)

  @@index([actorId, createdAt, id], map: "audit_logs_actor_idx")
  @@index([targetType, targetId, createdAt, id], map: "audit_logs_target_idx")
  @@map("audit_logs")
}

model AuthLoginLimit {
  scope        String   @db.VarChar(16)
  subjectHash  String   @map("subject_hash") @db.Char(64)
  windowStart  DateTime @map("window_start")
  failureCount Int      @default(0) @map("failure_count") @db.UnsignedInt

  @@id([scope, subjectHash])
  @@map("auth_login_limits")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model commission_entries {
  id            BigInt      @id @default(autoincrement())
  restaurant_id BigInt
  order_id      BigInt      @unique
  kind          String      @db.VarChar(16)
  amount_vnd    BigInt
  actor_id      BigInt
  created_at    DateTime    @default(now())
  accounts      Account     @relation(fields: [actor_id], references: [id])
  orders        orders      @relation(fields: [order_id], references: [id])
  restaurants   restaurants @relation(fields: [restaurant_id], references: [id])

  @@index([actor_id], map: "commission_entries_actor_id_fkey")
  @@index([restaurant_id, created_at, id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model commission_policies {
  restaurant_id BigInt      @id
  rate          Decimal     @db.Decimal(12, 8)
  version       Int         @default(1) @db.UnsignedInt
  created_at    DateTime    @default(now())
  updated_at    DateTime
  restaurants   restaurants @relation(fields: [restaurant_id], references: [id])
}

model delivery_policies {
  restaurant_id           BigInt                    @id
  version                 Int                       @default(1) @db.UnsignedInt
  created_at              DateTime                  @default(now())
  updated_at              DateTime
  restaurants             restaurants               @relation(fields: [restaurant_id], references: [id])
  restaurant_pickup_rates restaurant_pickup_rates[]
}

model dish_categories {
  id     BigInt   @id @default(autoincrement())
  name   String   @unique @db.VarChar(100)
  dishes dishes[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dishes {
  id              BigInt          @id @default(autoincrement())
  restaurant_id   BigInt
  category_id     BigInt
  name            String          @db.VarChar(200)
  description     String          @db.Text
  price_vnd       BigInt
  image_reference String?         @db.VarChar(2048)
  is_visible      Boolean         @default(true)
  is_available    Boolean         @default(true)
  version         Int             @default(1) @db.UnsignedInt
  created_at      DateTime        @default(now())
  updated_at      DateTime
  dish_categories dish_categories @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "dishes_category_fk")
  restaurants     restaurants     @relation(fields: [restaurant_id], references: [id], onUpdate: Restrict, map: "dishes_restaurant_fk")
  order_items     order_items[]

  @@unique([id, restaurant_id], map: "dishes_id_restaurant_key")
  @@index([category_id], map: "dishes_category_fk")
  @@index([restaurant_id, is_visible, is_available, category_id, price_vnd, id], map: "dishes_menu_idx")
  @@index([name, id])
  @@index([restaurant_id, is_visible, is_available])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id                 BigInt @id @default(autoincrement())
  order_id           BigInt
  dish_id            BigInt
  dish_name_snapshot String @db.VarChar(200)
  unit_price_vnd     BigInt
  quantity           Int    @db.UnsignedInt
  line_total_vnd     BigInt
  dishes             dishes @relation(fields: [dish_id], references: [id])
  orders             orders @relation(fields: [order_id], references: [id])

  @@unique([order_id, dish_id])
  @@index([dish_id], map: "order_items_dish_id_fkey")
}

model order_payment_history {
  id              BigInt                             @id @default(autoincrement())
  order_id        BigInt
  payment_version Int                                @db.UnsignedInt
  from_status     order_payment_history_from_status?
  to_status       order_payment_history_to_status
  actor_id        BigInt
  created_at      DateTime                           @default(now())
  accounts        Account                            @relation(fields: [actor_id], references: [id])
  orders          orders                             @relation(fields: [order_id], references: [id])

  @@unique([order_id, payment_version])
  @@index([actor_id])
}

model order_payments {
  order_id     BigInt                @id
  method       order_payments_method
  status       order_payments_status @default(unpaid)
  confirmed_by BigInt?
  confirmed_at DateTime?
  version      Int                   @default(1) @db.UnsignedInt
  updated_at   DateTime
  accounts     Account?              @relation(fields: [confirmed_by], references: [id], onDelete: Restrict)
  orders       orders                @relation(fields: [order_id], references: [id])

  @@index([confirmed_by], map: "order_payments_confirmed_by_fkey")
}

model order_requests {
  id              BigInt   @id @default(autoincrement())
  actor_id        BigInt
  operation       String   @db.VarChar(32)
  idempotency_key String   @db.VarChar(128)
  request_hash    String   @db.Char(64)
  order_id        BigInt?  @unique
  created_at      DateTime @default(now())
  accounts        Account  @relation(fields: [actor_id], references: [id])
  orders          orders?  @relation(fields: [order_id], references: [id], onDelete: Restrict)

  @@unique([actor_id, operation, idempotency_key])
}

model order_status_history {
  id            BigInt                            @id @default(autoincrement())
  order_id      BigInt
  order_version Int                               @db.UnsignedInt
  from_status   order_status_history_from_status?
  to_status     order_status_history_to_status
  actor_id      BigInt
  reason        String?                           @db.VarChar(1000)
  created_at    DateTime                          @default(now())
  accounts      Account                           @relation(fields: [actor_id], references: [id])
  orders        orders                            @relation(fields: [order_id], references: [id])

  @@unique([order_id, order_version])
  @@index([actor_id], map: "order_status_history_actor_id_fkey")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                             BigInt                  @id @default(autoincrement())
  student_id                     BigInt
  restaurant_id                  BigInt
  status                         orders_status           @default(pending)
  pickup_point_id                BigInt
  pickup_point_name_snapshot     String                  @db.VarChar(200)
  recipient_name_snapshot        String                  @db.VarChar(200)
  recipient_phone_snapshot       String                  @db.VarChar(32)
  destination_text_snapshot      String                  @db.VarChar(1000)
  destination_latitude_snapshot  Decimal                 @db.Decimal(9, 6)
  destination_longitude_snapshot Decimal                 @db.Decimal(9, 6)
  distance_m_snapshot            Int                     @db.UnsignedInt
  delivery_quote_snapshot        Json
  subtotal_vnd                   BigInt
  delivery_fee_vnd               BigInt
  total_vnd                      BigInt
  commission_rate_snapshot       Decimal                 @db.Decimal(12, 8)
  version                        Int                     @default(1) @db.UnsignedInt
  completed_at                   DateTime?
  created_at                     DateTime                @default(now())
  updated_at                     DateTime
  commission_entries             commission_entries?
  order_items                    order_items[]
  order_payment_history          order_payment_history[]
  order_payments                 order_payments?
  order_requests                 order_requests?
  order_status_history           order_status_history[]
  pickup_points                  pickup_points           @relation(fields: [pickup_point_id], references: [id])
  restaurants                    restaurants             @relation(fields: [restaurant_id], references: [id])
  accounts                       Account                 @relation(fields: [student_id], references: [id])

  @@index([pickup_point_id], map: "orders_pickup_point_id_fkey")
  @@index([restaurant_id, status, created_at, id])
  @@index([student_id, created_at, id])
}

model pickup_points {
  id                      BigInt                    @id @default(autoincrement())
  name                    String                    @db.VarChar(200)
  latitude                Decimal                   @db.Decimal(9, 6)
  longitude               Decimal                   @db.Decimal(9, 6)
  is_active               Boolean                   @default(true)
  version                 Int                       @default(1) @db.UnsignedInt
  created_at              DateTime                  @default(now())
  updated_at              DateTime
  orders                  orders[]
  restaurant_pickup_rates restaurant_pickup_rates[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model restaurant_hours {
  id              BigInt      @id @default(autoincrement())
  restaurant_id   BigInt
  weekday         Int         @db.UnsignedTinyInt
  opens_at        String      @db.VarChar(8)
  closes_at       String      @db.VarChar(8)
  closes_next_day Boolean     @default(false)
  restaurants     restaurants @relation(fields: [restaurant_id], references: [id])

  @@index([restaurant_id, weekday])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model restaurant_pickup_rates {
  restaurant_id     BigInt
  pickup_point_id   BigInt
  distance_m        Int               @db.UnsignedInt
  delivery_fee_vnd  BigInt
  is_enabled        Boolean           @default(true)
  version           Int               @default(1) @db.UnsignedInt
  created_at        DateTime          @default(now())
  updated_at        DateTime
  pickup_points     pickup_points     @relation(fields: [pickup_point_id], references: [id])
  delivery_policies delivery_policies @relation(fields: [restaurant_id], references: [restaurant_id])

  @@id([restaurant_id, pickup_point_id])
  @@index([pickup_point_id], map: "restaurant_pickup_rates_pickup_point_id_fkey")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model restaurants {
  id                  BigInt               @id @default(autoincrement())
  owner_id            BigInt               @unique(map: "restaurants_owner_unique")
  name                String               @db.VarChar(200)
  address             String               @db.VarChar(1000)
  contact_phone       String               @db.VarChar(32)
  readiness           String               @default("setup_required") @db.VarChar(32)
  is_active           Boolean              @default(true)
  is_accepting_orders Boolean              @default(false)
  version             Int                  @default(1) @db.UnsignedInt
  created_at          DateTime             @default(now())
  updated_at          DateTime
  latitude            Decimal?             @db.Decimal(9, 6)
  longitude           Decimal?             @db.Decimal(10, 6)
  commission_entries  commission_entries[]
  commission_policies commission_policies?
  delivery_policies   delivery_policies?
  dishes              dishes[]
  orders              orders[]
  restaurant_hours    restaurant_hours[]
  accounts            Account              @relation(fields: [owner_id], references: [id])

  @@index([is_active, name, id])
  @@index([owner_id, id])
}

enum AccountRole {
  student
  restaurant_owner
  admin
}

enum RoleRequestStatus {
  pending
  approved
  rejected
}

enum order_payments_method {
  cash
  qr
}

enum order_payments_status {
  unpaid
  paid
  refund_pending
  refunded
}

enum order_payment_history_from_status {
  unpaid
  paid
  refund_pending
  refunded
}

enum order_status_history_from_status {
  pending
  accepted
  rejected
  cancelled
  delivering
  completed
}

enum orders_status {
  pending
  accepted
  rejected
  cancelled
  delivering
  completed
}

enum order_payment_history_to_status {
  unpaid
  paid
  refund_pending
  refunded
}

enum order_status_history_to_status {
  pending
  accepted
  rejected
  cancelled
  delivering
  completed
}



// Singleton authority is the sole source of Admin authorization. Legacy Account.role is historical.
model AdminAuthority {
  id Int @id @db.UnsignedTinyInt
  accountId BigInt @unique @map("account_id")
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@map("admin_authority")
}
model AdminFactor {
  accountId BigInt @id @map("account_id")
  encryptedSecret String @map("encrypted_secret") @db.VarChar(512)
  enrolledAt DateTime? @map("enrolled_at") @db.DateTime(3)
  lastStep BigInt @default(-1) @map("last_step")
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@map("admin_factors")
}
model AdminChallenge {
  id String @id @db.Char(64)
  accountId BigInt @map("account_id")
  authVersion Int @map("auth_version") @db.UnsignedInt
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  attempts Int @default(0) @db.UnsignedInt
  consumedAt DateTime? @map("consumed_at") @db.DateTime(3)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([expiresAt])
  @@map("admin_challenges")
}
model AdminRecoveryCode {
  hash String @id @db.Char(64)
  accountId BigInt @map("account_id")
  consumedAt DateTime? @map("consumed_at") @db.DateTime(3)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId])
  @@map("admin_recovery_codes")
}

model AdminMfaLimit {
  scope String @db.VarChar(16)
  subjectHash String @map("subject_hash") @db.Char(64)
  windowStart DateTime @map("window_start") @db.DateTime(3)
  attemptCount Int @map("attempt_count") @default(0) @db.UnsignedInt
  @@id([scope, subjectHash])
  @@map("admin_mfa_limits")
}

model AdminOperatorRequest {
  requestId String @id @map("request_id") @db.VarChar(128)
  accountId BigInt @map("account_id")
  operation String @db.VarChar(16)
  requestHash String @map("request_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@map("admin_operator_requests")
}
