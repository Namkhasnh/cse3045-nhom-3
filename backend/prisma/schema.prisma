generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum AccountRole {
  student
  restaurant_owner
  admin
}

model Account {
  id              BigInt      @id @default(autoincrement())
  loginIdentifier String      @unique @map("login_identifier") @db.VarChar(191)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  role            AccountRole
  displayName     String      @map("display_name") @db.VarChar(200)
  phone           String?     @db.VarChar(32)
  isActive        Boolean     @default(true) @map("is_active")
  authVersion     Int         @default(1) @map("auth_version") @db.UnsignedInt
  createdAt       DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  auditLogs       AuditLog[]

  @@map("accounts")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    BigInt   @map("actor_id")
  action     String   @db.VarChar(64)
  targetType String   @map("target_type") @db.VarChar(64)
  targetId   BigInt   @map("target_id")
  changes    Json
  requestId  String?  @map("request_id") @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  actor      Account  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt, id])
  @@index([actorId, createdAt, id])
  @@map("audit_logs")
}
