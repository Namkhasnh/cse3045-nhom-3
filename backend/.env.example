# Copy to .env and replace these placeholders with your local MySQL credentials.
# The database must already exist. URL-encode special characters in credentials.
DATABASE_URL="mysql://app_user:change_me@127.0.0.1:3306/hoa_lac_food"
PORT=3000
# Use two independent 32-byte random hex keys; never reuse these examples.
JWT_SIGNING_KEY=CHANGE_ME_64_HEX_CHARACTERS
CSRF_HMAC_KEY=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS
JWT_ISSUER=hoa-lac-food
JWT_AUDIENCE=hoa-lac-food-web
JWT_KEY_ID=local-1
# Optional JSON array of {"id":"old-id","key":"64 hex chars","retired_at":UnixSeconds}; remove after 15 minutes.
JWT_PREVIOUS_KEYS=[]
PUBLIC_ORIGIN=https://localhost.example
# SMTP relay for real email verification; use app-specific credentials and TLS (465 implicit, 587 STARTTLS).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=change_me
# SMTP_PASSWORD=change_me
# SMTP_FROM="Hoa Lac Food <no-reply@example.com>"
# Trust only the known reverse proxy peer IPs; it must overwrite X-Forwarded-For.
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# Operator-only provisioning: paths to the signed manifest and pinned reviewer public key.
# ACCOUNT_PROVISION_MANIFEST=/protected/path/request.json
# ACCOUNT_PROVISION_REVIEWER_PUBLIC_KEY=/protected/path/reviewer-ed25519.pub.pem

# Admin encryption material must be injected from protected storage outside this repo.
# ADMIN_MFA_ENCRYPTION_KEY=<separate 64-hex key; never a frontend variable>
# Or a protected external file containing only the same 64-hex key (optional final newline).
# Direct ADMIN_MFA_ENCRYPTION_KEY takes precedence; never replace an enrolled key.
# ADMIN_MFA_ENCRYPTION_KEY_FILE=/protected/path/admin-mfa.key
# CUTOVER_RESTORE_EVIDENCE=/protected/restore-evidence.json
# RESTORE_DATABASE_URL=<new disposable loopback test_* database, MySQL 9.2.0>
# REHEARSAL_OUTPUT=/private/tmp/<new-private-rehearsal-directory>

# CLI only. Separate restricted user on the SAME server/database; no runtime fallback.
# PROVISION_DATABASE_URL="mysql://hlf_provision:change_me@127.0.0.1:3306/hoa_lac_food"
# DATABASE_URL must use a fresh restricted runtime identity; see prisma/permissions/grants.sql.
# Migration credentials are injected only into the migration job's DATABASE_URL.

# DEC-09: backend only. Dedicated project WITHOUT billing; verify quotas in AI Studio.
AI_ENABLED=false
AI_FREE_TIER_VERIFIED=false
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
AI_PROJECT_RPM=
AI_PROJECT_TPM=
AI_PROJECT_RPD=
# 32-byte hex key, independent of auth keys, for ephemeral IP quota hashes.
AI_QUOTA_HMAC_KEY=
